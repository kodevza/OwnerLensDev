---
import { ArrowRight, ArrowUpRight, Search } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import TopicGrid from '../components/TopicGrid.astro';
import { researchFormats } from '../lib/research-formats';

---
<BaseLayout current="home">
  <header class="research-hero">
    <h1>Non-human identity research</h1>
    <div>
      <p class="lead">Technical research on authentication, access and governance for workloads, services and AI agents.</p>
      <div class="actions">
        <a class="button primary" href="/research/">Explore Research Library <ArrowRight size={17} aria-hidden="true" /></a>
        <a class="research-link" href="#knowledge-domains">Browse domains</a>
      </div>
    </div>
  </header>

  <section class="research-home-section" aria-labelledby="research-library">
    <div class="research-section-heading">
      <div>
        <h2 id="research-library">Research Library</h2>
      </div>
      <form class="research-home-search" action="/research/" role="search" aria-label="Search the Research Library">
        <label class="visually-hidden" for="home-research-search">Search research</label>
        <input id="home-research-search" name="q" type="search" placeholder="Search research" required />
        <button class="button" type="submit"><Search size={17} aria-hidden="true" />Search</button>
      </form>
    </div>
    <ul class="format-grid">
      {Object.entries(researchFormats).map(([key, { title, description }]) => (
        <li>
          <a class="format-card" href={`/research/?format=${key}`}>
            <h3>{title}</h3>
            <p>{description}</p>
            <ArrowUpRight class="format-card__arrow" size={17} aria-hidden="true" />
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="research-home-section" aria-labelledby="knowledge-domains">
    <h2 id="knowledge-domains">Research domains</h2>
    <TopicGrid />
  </section>
</BaseLayout>
