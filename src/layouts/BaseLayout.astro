---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  current?: string;
  type?: 'website' | 'article';
}

const {
  title = 'OwnerLens — Non-human identity',
  description = 'A technical knowledge base on non-human identity, governance, workload access, AI agents and MCP.',
  current = '',
  type = 'website',
} = Astro.props;

const pageTitle = title.includes('OwnerLens') ? title : `${title} | OwnerLens`;
const navigation = [
  { id: 'research', title: 'Research Library', url: '/research/' },
  { id: 'domains', title: 'Domains', url: '/topics/' },
  { id: 'tools', title: 'Tools', url: '/tools/' },
  { id: 'become-an-author', title: 'Become an Author', url: '/become-an-author/' },
  { id: 'advisory', title: 'Advisory', url: '/advisory/' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={Astro.url.href} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={Astro.url.href} />
    <script src="/code-copy.js" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        <div class="site-header__inner">
          <a class="brand" href="/">
            <img src="/brand/ownerlens.png" alt="OwnerLens" width="1087" height="175" />
          </a>
          <nav class="nav" aria-label="Main navigation">
            {navigation.map(({ id, title, url }) => (
              <a href={url} aria-current={current === id ? (Astro.url.pathname === url ? 'page' : 'location') : undefined}>{title}</a>
            ))}
          </nav>
        </div>
      </header>
      <main id="main-content">
        <slot />
      </main>
      <footer class="site-footer">
        <div class="site-footer__inner">
          <a class="brand" href="/">
            <img src="/brand/ownerlens.png" alt="OwnerLens" width="1087" height="175" />
          </a>
          <nav class="footer-nav" aria-label="Footer navigation">
            {navigation.map(({ title, url }) => <a href={url}>{title}</a>)}
          </nav>
        </div>
      </footer>
    </div>
  </body>
</html>
