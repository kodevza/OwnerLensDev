---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { domains } from '../lib/topics';
import { researchFormats, type ResearchFormat } from '../lib/research-formats';

const { frontmatter, headings } = Astro.props;
const entryDomains = domains.filter(({ slug }) => frontmatter.topics?.includes(slug));
const format = researchFormats[frontmatter.format as ResearchFormat] ?? researchFormats['technical-note'];
const title = frontmatter.title.replace(/^Field Note:\s*/i, '');

---
<BaseLayout title={title} description={frontmatter.description ?? 'OwnerLens knowledge entry'} current="research" type="article">
  <div class="content-layout">
    <article class:list={['content', { 'center-images': frontmatter.centerImages }]}>
      <a class="back-link" href="/research/">← Research Library</a>
      {entryDomains.length > 0 && (
        <ul class="article-topics" aria-label="Knowledge domains">
          {entryDomains.map(({ title, slug }) => <li><a href={`/topics/${slug}/`}>{title}</a></li>)}
        </ul>
      )}
      <p class="research-format">{format.label}</p>
      <h1>{title}</h1>
      {frontmatter.warning && <p class="warning">{frontmatter.warning}</p>}
      <slot />
    </article>
    <TableOfContents headings={headings} />
  </div>
</BaseLayout>

<style>
  .content.center-images :global(img) {
    display: block;
    margin-inline: auto;
  }

  .content.center-images :global(img[src$=".svg"]) {
    background: #1c2121;
  }
</style>
