---
import { ArrowUpRight } from '@lucide/astro';
import type { notes } from '../lib/notes';

interface Props {
  items: typeof notes;
}

const { items } = Astro.props;
---
<ul class="article-list">
  {items.map(({ url, title, description }) => (
    <li>
      <a class="article-item" href={url}>
        <h3>{title}</h3>
        <p>{description}</p>
        <ArrowUpRight class="article-arrow" size={18} aria-hidden="true" />
      </a>
    </li>
  ))}
</ul>
